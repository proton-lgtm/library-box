{
  "name": "game-library",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first cross-platform desktop game library.",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "cross-env OPEN_DEVTOOLS=0 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "clear:storage": "electron scripts/clear-electron-storage.cjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "better-sqlite3@13.0.3": true,
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "jsdom": {
      "undici": "^8.12.2"
    }
  },
  "build": {
    "appId": "com.game.library",
    "productName": "Library",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/logo.png",
        "to": "logo.png"
      }
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": "portable",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "category": "Game",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
