# Copy to .env.local inside signup-website. Never commit actual secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Modern sb_secret_ key; the legacy service-role key is also supported.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SERVER_ONLY_TURNSTILE_SECRET
# Comma-separated hostnames, no schemes, ports or wildcards.
TURNSTILE_EXPECTED_HOSTNAMES=localhost
# Publish your real operator privacy policy before accepting signups.
PRIVACY_POLICY_URL=https://YOUR_DOMAIN/privacy
