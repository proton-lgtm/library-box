{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Electron with MCP debugging",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --inspect=5858 --remote-debugging-port=9222 --sourcemap"
    },
    {
      "name": "Attach to Electron main",
      "type": "node",
      "request": "attach",
      "port": 5858,
      "restart": true,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Electron downloads",
      "configurations": [
        "Run Electron with MCP debugging",
        "Attach to Electron main"
      ],
      "stopAll": true
    }
  ]
}
